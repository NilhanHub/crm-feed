# CRM Feed — Environment Variables Example
#
# ============================================================================
#  PLACEHOLDERS ONLY — NO REAL SECRETS.
#  This file is safe to commit. It must NEVER contain real API keys, tokens,
#  passwords, or credentials. Copy it to `.env` and fill in real values there.
#  `.env` is gitignored and must never be committed.
# ============================================================================
#
# All Google/Gemini resources must be under nilhan.dev@gmail.com only.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# API server port (default: 8787)
PORT=8787

# Web UI origin used for CORS (default: http://localhost:5173)
WEB_ORIGIN=http://localhost:5173

# Runtime environment: "development" or "production"
NODE_ENV=development

# ---------------------------------------------------------------------------
# Gemini extraction
# ---------------------------------------------------------------------------

# REQUIRED for live extraction. Replace the placeholder below with a real key
# in your local .env (never commit the real key). Under nilhan.dev@gmail.com.
GEMINI_API_KEY=PLACEHOLDER_REPLACE_WITH_REAL_KEY_IN_DOTENV

# Optional alternative to GEMINI_API_KEY: path to a Google service account
# JSON key file. If set, used instead of the API key for authentication.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Gemini model to use for extraction (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Maximum automatic retries for transient Gemini failures (default: 2)
GEMINI_MAX_RETRIES=2

# Per-request timeout for Gemini calls, in milliseconds (default: 60000)
GEMINI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Informational (set automatically by scripts, not by you)
# ---------------------------------------------------------------------------

# Result of the most recent `node scripts/data-integrity-check.mjs` run.
# Informational only; do not set manually.
# LAST_INTEGRITY_CHECK_STATUS=unknown
